#!/usr/bin/python3
"""omapass keyring helper — pinned binaries, libsecret backend, no PATH lookups."""

import argparse
import json
import os
import secrets
import sys

os.environ["PATH"] = "/usr/bin:/bin"
# `python3 -I` leaves the script's directory off sys.path.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from omapass_lib import common, keyfile_guard, keyring_store, nostr, secret_io  # noqa: E402


def cmd_list(args):
    items = keyring_store.get_backend().list_items()
    if args.json:
        print(json.dumps(items, ensure_ascii=False))
        return
    for row in items:
        print(f"{common.printable(row['account'])}\t{common.printable(row['folder'])}")


def cmd_get(args):
    if sys.stdout.isatty() and not args.yes:
        common.die("refusing to print a secret to a terminal; pipe the output or pass --yes")
    account = args.account or common.take_account(args.rest)
    print(keyring_store.get_backend().get_secret(account, args.kind, args.folder), end="")


def cmd_store(args):
    account = args.account
    folder = args.folder or args.label
    if not account:
        common.die("store requires --account")
    if not folder:
        common.die("store requires --folder or --label")
    secret = secret_io.strip_one_newline(sys.stdin.read())
    secret_io.validate_entry(account, folder, secret, args.kind or "")
    keyring_store.get_backend().store(account, folder, secret, args.kind or "", args.replace)


def cmd_add(args):
    account = args.account
    folder = args.folder or args.label
    if not account:
        common.die("add requires --account")
    if not folder:
        common.die("add requires --folder or --label")
    secret = secret_io.read_secret_value()
    secret_io.validate_entry(account, folder, secret, args.kind or "")
    keyring_store.get_backend().store(account, folder, secret, args.kind or "", args.replace)

def cmd_clear(args):
    account = args.account or common.take_account(args.rest)
    keyring_store.get_backend().clear(account, args.kind, args.folder)


def cmd_exists(args):
    account = args.account
    if not account:
        common.die("exists requires --account")
    raise SystemExit(0 if keyring_store.get_backend().exists(account, args.kind, args.folder) else 1)


def cmd_generate_password(_args):
    print(secrets.token_urlsafe(18))



def build_parser():
    parser = argparse.ArgumentParser(prog="omapass-keyring", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    sub = parser.add_subparsers(dest="command")

    p_list = sub.add_parser("list")
    p_list.add_argument("--json", action="store_true")

    p_get = sub.add_parser("get")
    p_get.add_argument("--yes", action="store_true")
    p_get.add_argument("--account")
    p_get.add_argument("--kind", default="")
    p_get.add_argument("--folder")
    p_get.add_argument("rest", nargs=argparse.REMAINDER)

    p_store = sub.add_parser("store")
    p_store.add_argument("--account")
    p_store.add_argument("--folder")
    p_store.add_argument("--label")
    p_store.add_argument("--kind", default="")
    p_store.add_argument("--replace", action="store_true")

    p_add = sub.add_parser("add")
    p_add.add_argument("--account")
    p_add.add_argument("--folder")
    p_add.add_argument("--label")
    p_add.add_argument("--kind", default="")
    p_add.add_argument("--replace", action="store_true")

    p_clear = sub.add_parser("clear")
    p_clear.add_argument("--kind", default="")
    p_clear.add_argument("--folder")
    p_clear.add_argument("--account")
    p_clear.add_argument("--item-stdin", action="store_true")
    p_clear.add_argument("rest", nargs=argparse.REMAINDER)

    p_rm = sub.add_parser("rm")
    p_rm.add_argument("--kind", default="")
    p_rm.add_argument("--folder")
    p_rm.add_argument("rest", nargs=argparse.REMAINDER)

    p_exists = sub.add_parser("exists")
    p_exists.add_argument("--kind", default="")
    p_exists.add_argument("--folder")
    p_exists.add_argument("--account", required=True)

    p_copy = sub.add_parser("copy")
    p_copy.add_argument("--kind", default="")
    p_copy.add_argument("--folder")
    p_copy.add_argument("--account")
    p_copy.add_argument("--item-stdin", action="store_true")
    p_copy.add_argument("rest", nargs=argparse.REMAINDER)

    sub.add_parser("copy-text")

    p_clipboard_serve = sub.add_parser("clipboard-serve")
    p_clipboard_serve.add_argument("--ttl", type=float, default=secret_io.CLIPBOARD_TTL_S)
    sub.add_parser("focus-snapshot")

    p_type = sub.add_parser("type")
    p_type.add_argument("--kind", default="")
    p_type.add_argument("--folder")
    p_type.add_argument("--account")
    p_type.add_argument("--item-stdin", action="store_true")
    p_type.add_argument("--compositor", choices=("hyprland", "niri"))
    p_type.add_argument("--expect-id")
    p_type.add_argument("rest", nargs=argparse.REMAINDER)

    sub.add_parser("generate-password")
    sub.add_parser("doctor")

    p_gen_nostr = sub.add_parser("generate-nostr")
    p_gen_nostr.add_argument("--account")
    p_gen_nostr.add_argument("--folder")
    p_gen_nostr.add_argument("--replace", action="store_true")

    p_nostr = sub.add_parser("nostr")
    nostr_sub = p_nostr.add_subparsers(dest="nostr_cmd")

    p_nostr_new = nostr_sub.add_parser("new")
    p_nostr_new.add_argument("--account")
    p_nostr_new.add_argument("--folder")

    p_nostr_npub = nostr_sub.add_parser("show-npub")
    p_nostr_npub.add_argument("--account")
    p_nostr_npub.add_argument("rest", nargs=argparse.REMAINDER)

    p_nostr_nsec = nostr_sub.add_parser("show-nsec")
    p_nostr_nsec.add_argument("--account")
    p_nostr_nsec.add_argument("rest", nargs=argparse.REMAINDER)

    p_nostr_rm = nostr_sub.add_parser("rm")
    p_nostr_rm.add_argument("--account")
    p_nostr_rm.add_argument("rest", nargs=argparse.REMAINDER)

    return parser


def usage():
    print(
        """Usage: omapass-keyring <command> [options]

Commands:
  list [--json]                 List saved logins (account + folder)
  get [--account <id>] [--yes] | get [--] <account>   (--yes required on TTY)
  store --account <id> --folder <name> [--kind K] [--replace]   Secret on stdin;
                                refuses (exit 4) to replace unless --replace
  add --account <id> --folder <name> [--kind K] [--replace]     Prompt or stdin
  (a name that starts with "-": write --account=<name>; exit 5 = unsafe keyring,
   6 = write not confirmed, 2 = bad arguments)
  clear --account <id> | rm [--] <account>   [--kind K] [--folder F]
  exists --account <id> [--kind K] [--folder F]   Exit 0/1
  (identity is account + kind; get/copy/type/clear/exists take --kind, default none,
   and --folder F to pick one of several items that share them; without it,
   several items are never guessed between: exit 12 and nothing is done.
   list --json flags such items with warn "duplicate")
  (copy, type and clear also take --item-stdin: one JSON object on stdin with
   account, and optionally kind, folder, compositor and expect_id, all strings;
   the panel uses it so names stay out of the process list)
  copy [--account <id>] | copy [--] <account>   (until replaced, or 30 s)
  copy-text                     Copy stdin to clipboard (same lifetime)
  clipboard-serve [--ttl <seconds>]   Internal: serve stdin until replaced or TTL
  focus-snapshot                JSON focused window id
  type --account <id> [--compositor hyprland|niri --expect-id ID]
                                exit 8 = focus, layers or session lock changed or
                                cannot be read (nothing more typed),
                                9 = wtype failed or /tmp unsafe, 3 = no compositor focus,
                                10 = keyring unavailable, locked or missing (any command),
                                11 = NFC/NFD twins, 12 = several items (pass --folder),
                                13 = stored secret has control characters (copy and type)
  generate-password             One-line random password
  doctor                        Read-only keyring check (exit 10 if the default keyring is locked)
  generate-nostr --account <id> --folder <name> [--replace]
  nostr new|show-npub|show-nsec|rm
"""
    )


def run_handler(handler, args):
    """Run a command; an unreachable keyring or other failure is one line, never a traceback."""
    try:
        handler(args)
    except Exception as exc:
        glib = sys.modules.get("gi.repository.GLib")
        if glib is not None and isinstance(exc, glib.Error):
            common.die(f"keyring unavailable: {common.one_line(exc.message)}", common.EXIT_KEYRING_UNAVAILABLE)
        # The class name only: other messages could echo user input.
        common.die(f"internal error: {type(exc).__name__}")


def main(argv=None):
    secret_io.harden_process()
    argv = list(argv or sys.argv[1:])
    if not argv or argv[0] in ("-h", "--help"):
        usage()
        raise SystemExit(0 if argv and argv[0] in ("-h", "--help") else 1)

    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "item_stdin", False):
        secret_io.read_item_stdin(args, argv)

    handlers = {
        "list": cmd_list,
        "get": cmd_get,
        "store": cmd_store,
        "add": cmd_add,
        "clear": cmd_clear,
        "rm": lambda a: cmd_clear(
            type("X", (), {"account": None, "kind": a.kind, "folder": a.folder, "rest": a.rest})()
        ),
        "exists": cmd_exists,
        "copy": secret_io.cmd_copy,
        "clipboard-serve": secret_io.cmd_clipboard_serve,
        "copy-text": secret_io.cmd_copy_text,
        "focus-snapshot": secret_io.cmd_focus_snapshot,
        "type": secret_io.cmd_type,
        "generate-password": cmd_generate_password,
        "generate-nostr": nostr.cmd_generate_nostr,
        "doctor": keyfile_guard.cmd_doctor,
    }

    if args.command == "nostr":
        nostr_handlers = {
            "new": nostr.cmd_nostr_new,
            "show-npub": nostr.cmd_nostr_show_npub,
            "show-nsec": nostr.cmd_nostr_show_nsec,
            "rm": nostr.cmd_nostr_rm,
        }
        handler = nostr_handlers.get(args.nostr_cmd)
        if not handler:
            usage()
            raise SystemExit(1)
        run_handler(handler, args)
        return

    handler = handlers.get(args.command)
    if not handler:
        common.die(f"unknown command: {args.command}")
    run_handler(handler, args)


if __name__ == "__main__":
    main()
