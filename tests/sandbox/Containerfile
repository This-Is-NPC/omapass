# Disposable keyring sandbox for omapass.
# Runs gnome-keyring on a private D-Bus session with an empty-password
# Default_keyring, the same setup as the host. The host keyring and the host
# D-Bus are never mounted, so a test that breaks the keyring breaks only this one.
#
# Reproducible build: the base image is pinned by digest and pacman reads a
# dated Arch Linux Archive snapshot, so packages are pinned too. To bump, pull
# archlinux:latest, set the digest below from
#   docker inspect --format '{{index .RepoDigests 0}}' archlinux:latest
# and set SNAPSHOT to the image's creation date (YYYY/MM/DD).
ARG BASE=archlinux@sha256:d4594bb2300cba11f41c2f27923eb56f63d9988909c402f9c95517d1e362c899
ARG SNAPSHOT=2026/11/09

# Stage 1: coincurve, the secp256k1 binding `nostr show-npub` uses. Arch has no
# package for it, so build the pinned PyPI source (sha256 below) with the
# snapshot's toolchain; the final image gets only the built package.
FROM ${BASE} AS coincurve
ARG SNAPSHOT
ARG COINCURVE_URL=https://files.pythonhosted.org/packages/source/c/coincurve/coincurve-19.0.1.tar.gz
ARG COINCURVE_SHA256=c2191049e66792a1a19ca2e64b4d057be3ef1553105e5b9713a92b740c7809ee
RUN echo "Server = https://archive.archlinux.org/repos/$SNAPSHOT/\$repo/os/\$arch" \
      > /etc/pacman.d/mirrorlist \
    && pacman -Syu --noconfirm --needed python python-pip python-setuptools python-wheel \
      python-cffi gcc make pkgconf autoconf automake libtool git curl \
    && curl -fsSL -o /tmp/coincurve.tar.gz "$COINCURVE_URL" \
    && echo "$COINCURVE_SHA256  /tmp/coincurve.tar.gz" | sha256sum -c - \
    && pip install --no-deps --no-build-isolation --target /out /tmp/coincurve.tar.gz

FROM ${BASE}
ARG SNAPSHOT
RUN echo "Server = https://archive.archlinux.org/repos/$SNAPSHOT/\$repo/os/\$arch" \
      > /etc/pacman.d/mirrorlist \
    && pacman -Syu --noconfirm --needed \
      python python-gobject libsecret gnome-keyring dbus nodejs sway wl-clipboard wtype python-cffi python-asn1crypto \
    && pacman -Scc --noconfirm

COPY --from=coincurve /out/ /tmp/coincurve/
RUN cp -r /tmp/coincurve/coincurve* "$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/" \
    && rm -rf /tmp/coincurve

RUN useradd -m tester
COPY entrypoint.sh keyring-health.py /opt/sandbox/
RUN chmod 755 /opt/sandbox/entrypoint.sh

# Marker the tests require besides the env var; the host never has it.
RUN : > /opt/sandbox/IN_SANDBOX
ENV OMAPASS_SANDBOX=1
USER tester
WORKDIR /src
ENTRYPOINT ["/opt/sandbox/entrypoint.sh"]
CMD ["./tests/run.sh"]
